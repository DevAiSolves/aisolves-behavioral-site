# ============================================================================
# AISOLVES · variables de entorno (Vercel → Settings → Environment Variables)
# Este archivo es una plantilla y se versiona. El .env real NUNCA se sube:
# está en .gitignore. Ningún valor de aquí puede acabar en aisolves-site.html.
# ============================================================================

# --- Meta Conversions API -----------------------------------------------
# Token: Business Manager → Usuarios del sistema → generar token con
# ads_management. El de "acceso a la página" NO sirve para la CAPI.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Solo mientras validas en Events Manager → Probar eventos. Quítalo después:
# con test_event_code los eventos no cuentan para optimización.
META_TEST_EVENT_CODE=

# --- WhatsApp -------------------------------------------------------------
WA_PROVEEDOR=cloud              # cloud | manychat
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_PLANTILLA=reporte_visita     # debe estar APROBADA en WhatsApp Manager
WA_PLANTILLA_LANG=es
WA_PERMITIR_TEXTO=0             # 1 solo si la ventana de 24 h está abierta
WA_VERIFY_TOKEN=                # cadena que inventas tú, para el webhook
WA_APP_SECRET=                  # Meta → tu app → Configuración → Básica
MANYCHAT_TOKEN=

# --- CRM ------------------------------------------------------------------
CRM_WEBHOOK=
CRM_TOKEN=
LEAD_ORIGENES=https://aisolves.com

# --- Vercel KV ------------------------------------------------------------
# Las inyecta Vercel al conectar Upstash Redis desde el Marketplace.
# Sin ellas el envío funciona, pero no hay seguimiento de estado.
KV_REST_API_URL=
KV_REST_API_TOKEN=
